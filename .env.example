NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your business, shown to customers
NEXT_PUBLIC_BUSINESS_NAME=HomeQuote Local
NEXT_PUBLIC_BUSINESS_PHONE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required: the request form and customer pages use it. Never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=

# AI estimates (optional: without a key, the built-in calculator is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Where YOU get new-lead / message / approval alerts
CONTRACTOR_PHONE=
CONTRACTOR_EMAIL=

# Text messages (optional) — twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (optional) — resend.com; EMAIL_FROM must be on a domain you verified there
RESEND_API_KEY=
EMAIL_FROM=

# Online payments (optional) — stripe.com. Use test keys (sk_test_...) until you're ready.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, for https://YOUR-SITE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
