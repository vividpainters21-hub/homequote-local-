# Copy this file to meme-jarvis/.env and fill in real values.
# Nothing in this project sends real transactions or holds a private key —
# see "Live trading" in the Settings page / README before ever changing that.

# ---- Database (Postgres / Supabase) ----
# Local Postgres example (both vars can point at the same local DB):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meme_jarvis
#   DIRECT_URL=postgresql://postgres:postgres@localhost:5432/meme_jarvis
#
# Supabase (Project Settings -> Database -> Connect -> ORMs -> Prisma):
# DATABASE_URL is the pooled connection (port 6543, pgbouncer=true) the app
# uses at runtime. DIRECT_URL is the session-mode connection (port 5432)
# Prisma needs for `migrate` — PgBouncer's transaction mode doesn't support
# the prepared statements migrations require.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Solana / on-chain data ----
# Get a free Helius API key at https://dev.helius.xyz/ (Phase 2: mint/freeze authority,
# holder concentration, enhanced transactions, webhooks)
HELIUS_API_KEY=

# Optional. Only needed if you want finer-grained 1m/15m volume + unique-buyer
# data than DEX Screener provides on its own. https://docs.birdeye.so/
BIRDEYE_API_KEY=

# Optional override; only used if HELIUS_API_KEY is not set.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Fomo browser-extension ingest ----
# Shared secret between the Chrome extension (paste into its popup) and this
# backend's /api/fomo/ingest endpoint. Generate any random string.
FOMO_INGEST_API_KEY=change-me-to-a-random-string

# ---- Telegram alerts (Phase 9) ----
# Create a bot via @BotFather in Telegram to get a token, then message the bot
# (or add it to a group) and call:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find the numeric chat id for TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- API server ----
PORT=4000
# Set to "false" to disable the background scoring/risk/cluster/paper-trading loop
# (useful when just exploring the database or running tests).
PIPELINE_ENABLED=true
PIPELINE_INTERVAL_MS=30000

# ---- Scoring / alert thresholds (all optional, sane defaults apply) ----
STRONG_TRADER_SCORE=60
HIGH_SCORE_ALERT_THRESHOLD=90
STRONG_CLUSTER_ALERT_THRESHOLD=70
RAPID_SCORE_JUMP=15
WALLET_RECOMPUTE_EVERY_N_TICKS=10

# ---- Paper-trading exit-rule percentages (position sizing/limits live in the
# PaperAccount database row instead — see Settings page or PUT /api/paper/settings) ----
PAPER_STOP_LOSS_PCT=20
PAPER_TAKE_PROFIT_1_PCT=25
PAPER_TAKE_PROFIT_2_PCT=60
PAPER_TAKE_PROFIT_3_PCT=150
PAPER_TRAILING_STOP_PCT=15
PAPER_MAX_HOLD_TIME_SEC=21600

# ---- Dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:4000
